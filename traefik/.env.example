TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8090
# htpasswd-format credentials for the dashboard (PathPrefix `/` on the
# dashboard entrypoint). Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -Bbn <user> <password>
# then escape every '$' as '$$' before pasting here (docker-compose
# variable interpolation would otherwise mangle the hash).
TRAEFIK_DASHBOARD_HTPASSWD=CHANGE_ME
