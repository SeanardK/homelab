# --- Opsi A (aktif): pakai mysql_prod ---
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=CHANGE_ME

# --- Opsi B (MySQL bundled, kalau di-uncomment di compose) ---
# DB name/user di-hardcode di compose (wordpress_db / seanard),
# yang dipakai dari sini cuma WORDPRESS_DB_PASSWORD di atas + root password ini:
# WORDPRESS_MYSQL_ROOT_PASSWORD=CHANGE_ME
