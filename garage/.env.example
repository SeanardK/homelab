# Default bucket + key created on first start (--default-bucket)
GARAGE_DEFAULT_ACCESS_KEY=CHANGE_ME
GARAGE_DEFAULT_SECRET_KEY=CHANGE_ME
GARAGE_DEFAULT_BUCKET=CHANGE_ME

# Secrets kept out of garage.toml. Generate with:
#   openssl rand -hex 32     (rpc secret, must be 64 hex chars)
#   openssl rand -base64 32  (tokens)
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_METRICS_TOKEN=CHANGE_ME
